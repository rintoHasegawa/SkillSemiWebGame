{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "."
    /* "paths" は削除します（pnpm のワークスペース解決を使用するため） */
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
