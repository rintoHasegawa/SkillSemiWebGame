{
  "name": "Pixel Paint War Dev",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",

  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "26",
      "pnpmVersion": "10.28.2"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // ホストの Docker を使う (docker CLI + compose plugin．ソケットは docker-compose.yml でマウント)
    // moby: false … ベースイメージ (typescript-node:20) が Debian trixie になり moby-cli パッケージが無いため，Docker CE の CLI を入れる
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "EditorConfig.EditorConfig",
        "ms-vscode.hexeditor",
        "GitHub.copilot"
      ],
      "settings": {
        "editor.formatOnSave": false,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },

  // セットアップ処理は postcreate.sh に集約
  // (所有権修正・認証情報の復元・gh 連携・pnpm install・shared ビルド)
  "postCreateCommand": "bash .devcontainer/postcreate.sh",

  "remoteUser": "node"
}
